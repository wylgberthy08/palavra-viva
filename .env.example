# Contrato de ambiente
# Copie para `.env` e preencha. `.env` e `.env*.local` são ignorados pelo Git.

# Supabase — Painel do Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# API da Bíblia — opcional. Lido por src/config/bible.ts.
# Padrão: https://api.midvash.com
EXPO_PUBLIC_BIBLE_BASE_URL=
